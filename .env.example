# Copy this file to `.env` and fill in the values
# Secrets and configuration used by the Job Agent

# Google Gemini (GenAI) API key
GEMINI_API_KEY=

# Optional: model override (defaults to gemini-3.5-flash-lite in code)
MODEL=gemini-3.5-flash-lite

# Discord webhooks — either per-profile or a generic fallback
# Per-profile webhooks (preferred):
OLA_DISCORD_WEBHOOK_URL=
PETER_DISCORD_WEBHOOK_URL=

# Generic fallback webhook (used if per-profile not set)
DISCORD_WEBHOOK_URL=

# Optional tuning
#MIN_SCORE=6
